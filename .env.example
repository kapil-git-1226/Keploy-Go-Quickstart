# Copy this file to `.env.local` and fill in the values.
# Both are optional — the site builds and runs with neither set.

# Public URL of the GitHub repository for this project.
# When set, a "Source / GitHub" link appears in the header, hero and footer.
# When empty, those links are hidden rather than rendered dead.
NEXT_PUBLIC_REPO_URL=

# Canonical URL of the deployed site, used for metadata (metadataBase).
# Example: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=
